{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davicc",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "davi.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
