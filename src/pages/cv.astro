---
import Layout from '../layouts/Layout.astro';
import { cvDocuments } from '../lib/cv-documents';

const documents = cvDocuments;

const initialDocument = documents[0]!;
---

<Layout title="davi.cc | Resume" wide>
  <section class="cv-page" data-default-doc={initialDocument.id}>
    <aside class="cv-sidebar-col">
      <div class="cv-tabs-card">
        <div class="cv-tabs" role="tablist" data-i18n-aria-label="cv.versions" aria-label="Resume versions">
          {documents.map((doc) => (
            <button
              type="button"
              class={`cv-tab${doc.id === initialDocument.id ? ' is-active' : ''}`}
              role="tab"
              aria-selected={doc.id === initialDocument.id ? 'true' : 'false'}
              aria-controls="cv-embed"
              aria-label={doc.label}
              title={doc.label}
              data-doc-id={doc.id}
            >
              {doc.shortLabel}
            </button>
          ))}
        </div>
      </div>

      <div class="cv-actions">
        <a
          id="download-pdf-link"
          class="btn"
          href={initialDocument.pdfUrl}
          target="_blank"
          rel="noopener"
          data-doc-id={initialDocument.id}
          data-file-name={initialDocument.fileName}
        >
          <span class="btn-label" data-i18n-key="cv.download">Baixar em PDF</span>
        </a>
        <button type="button" id="share-cv" class="btn outline" data-i18n-key="cv.share">Compartilhar este currículo</button>
      </div>
    </aside>

    <article class="cv-document-shell">
      <div class="cv-embed-viewport">
        <iframe
          id="cv-embed"
          class="cv-embed"
          src={initialDocument.embedUrl}
          title={initialDocument.label}
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </article>

  </section>

  <script is:inline type="application/json" id="cv-documents-data" set:html={JSON.stringify(documents)}></script>

  <style>
    .cv-page {
      display: grid;
      grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .cv-sidebar-col {
      display: grid;
      gap: 1rem;
      align-self: start;
      position: sticky;
      top: 1.5rem;
    }

    .cv-tabs-card,
    .cv-document-shell,
    .cv-actions {
      border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
      background: color-mix(in oklab, var(--color-surface) 96%, transparent);
      border-radius: var(--border-radius-sm);
      box-shadow: var(--shadow-surface);
      padding: 1rem;
    }

    .cv-tabs-card {
      display: grid;
      gap: 0.65rem;
    }

    .cv-tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .cv-tab,
    .btn {
      appearance: none;
      border: 1px solid color-mix(in oklab, var(--color-border) 75%, transparent);
      background: color-mix(in oklab, var(--color-bg) 92%, transparent);
      color: inherit;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.55rem 0.9rem;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 600;
      transition: background-color 180ms ease, border-color 180ms ease, opacity 180ms ease;
    }

    .cv-tab {
      width: 100%;
      text-align: center;
      font-size: 0.86rem;
      padding: 0.5rem 0.4rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      width: 100%;
    }

    .cv-tab:hover,
    .btn:hover {
      background: color-mix(in oklab, var(--color-bg) 82%, transparent);
      border-color: color-mix(in oklab, var(--color-border) 88%, transparent);
      opacity: 0.8;
    }

    .cv-tab.is-active {
      background: color-mix(in oklab, var(--color-surface) 98%, transparent);
      border-color: color-mix(in oklab, var(--color-text) 22%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-text) 10%, transparent);
    }

    .cv-actions {
      display: grid;
      gap: 0.5rem;
    }

    .btn.outline {
      background: color-mix(in oklab, var(--color-bg) 92%, transparent);
    }

    .btn.outline:hover {
      background: color-mix(in oklab, var(--color-bg) 82%, transparent);
      border-color: color-mix(in oklab, var(--color-border) 88%, transparent);
      opacity: 0.8;
    }

    .btn.outline.is-success {
      color: #166534;
      background: #dcfce7;
      border-color: #86efac;
      opacity: 1;
    }

    .cv-document-shell {
      padding: 0.75rem;
    }

    .cv-embed-viewport {
      overflow: hidden;
      border-radius: calc(var(--border-radius-sm) - 2px);
    }

    .cv-embed {
      display: block;
      width: 100%;
      /* Letter-sized document plus equal space above and below the page. */
      height: calc(11in + 2rem);
      border: 0;
      border-radius: calc(var(--border-radius-sm) - 2px);
      background: #fff;
    }

    @media (max-width: 1080px) {
      .cv-page {
        grid-template-columns: 1fr;
      }

      .cv-sidebar-col {
        position: static;
      }

      .cv-actions {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .btn {
        min-width: 0;
      }
    }

    @media (max-width: 768px) {
      .cv-tabs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .cv-actions {
        grid-template-columns: 1fr;
      }

      .cv-document-shell {
        min-width: 0;
      }

      .cv-embed {
        /* Google mobilebasic reserves 57px for its header plus 20px above the document. */
        margin-top: -77px;
      }

    }
  </style>

  <script>
    // @ts-nocheck
    const initCvPage = () => {
      const pageRoot = document.querySelector('.cv-page');
      const dataElement = document.getElementById('cv-documents-data');
      const embedElement = document.getElementById('cv-embed');
      const downloadLink = document.getElementById('download-pdf-link');
      const shareButton = document.getElementById('share-cv');
      const tabElements = Array.from(document.querySelectorAll('.cv-tab'));

      if (!pageRoot || !dataElement || !embedElement || !downloadLink) return;
      if (pageRoot.dataset.initialized === 'true') return;
      pageRoot.dataset.initialized = 'true';

      let documents = [];
      try {
        documents = JSON.parse(dataElement.textContent || '[]');
      } catch {
        documents = [];
      }

      const documentMap = new Map(documents.map((doc) => [doc.id, doc]));
      const mobileQuery = window.matchMedia('(max-width: 768px)');
      let activeDocId = pageRoot.getAttribute('data-default-doc');

      const setActiveDocument = (docId) => {
        const doc = documentMap.get(docId);
        if (!doc || !doc.embedUrl) return;

        activeDocId = doc.id;
        const embedUrl = mobileQuery.matches ? doc.mobileEmbedUrl : doc.embedUrl;
        if (embedElement.src !== embedUrl) embedElement.src = embedUrl;
        embedElement.title = doc.label;
        downloadLink.href = doc.pdfUrl;
        downloadLink.setAttribute('data-doc-id', doc.id);
        downloadLink.setAttribute('data-file-name', doc.fileName);

        tabElements.forEach((tab) => {
          const isActive = tab.getAttribute('data-doc-id') === doc.id;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      };

      const preferredDocument = () => {
        const getLang = window.__i18n?.getLang?.() || navigator.language || 'en-US';
        const preferredId = String(getLang).startsWith('pt') ? 'ptbr' : 'enus';
        const preferred = documentMap.get(preferredId);
        if (preferred?.embedUrl) return preferred.id;
        return pageRoot.getAttribute('data-default-doc');
      };

      const preferredId = preferredDocument();
      if (preferredId) {
        setActiveDocument(preferredId);
      }

      mobileQuery.onchange = () => setActiveDocument(activeDocId);
      document.addEventListener('astro:before-swap', () => {
        mobileQuery.onchange = null;
      }, { once: true });

      tabElements.forEach((tab) => {
        tab.onclick = () => {
          const docId = tab.getAttribute('data-doc-id');
          if (docId) setActiveDocument(docId);
        };
      });

      if (shareButton) {
        shareButton.onclick = async () => {
          try {
            await navigator.clipboard.writeText(location.href);
            const t = window.__i18n?.t || ((k) => k);
            const original = t('cv.share');
            shareButton.classList.add('is-success');
            shareButton.textContent = t('cv.copied');
            setTimeout(() => {
              shareButton.classList.remove('is-success');
              shareButton.textContent = original;
            }, 1600);
          } catch {
            window.prompt('Copy this URL:', location.href);
          }
        };
      }
    };

    initCvPage();
    document.addEventListener('astro:page-load', initCvPage);
    document.addEventListener('astro:after-swap', initCvPage);
  </script>
</Layout>
